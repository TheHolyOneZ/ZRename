{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZRename",
  "version": "0.1.0",
  "identifier": "com.zlogic.zrename",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZRename",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Bulk file renamer with a live preview and a real undo",
    "longDescription": "ZRename renames thousands of files at once without the fear. Stack up rules \u2014 find and replace, regex, case, numbering, EXIF, ID3 and video metadata tokens \u2014 and watch a live before/after table with collisions flagged before anything moves. Every batch is journalled to disk first, so the whole thing can be undone even after a restart.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "desktopTemplate": "desktop-entry.desktop"
      },
      "rpm": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "TheHolyOneZ",
    "homepage": "https://zsync.eu/zrename/",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 TheHolyOneZ",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "zrename-desktop"
}
